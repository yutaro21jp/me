# --- コメント ---

# Giscus: https://giscus.app で各 ID を取得
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Utterances
NEXT_PUBLIC_UTTERANCES_REPO=

# Disqus
NEXT_PUBLIC_DISQUS_SHORTNAME=

# --- ニュースレター ---

# 登録先: resend / buttondown / mailchimp / convertkit / klaviyo / emailoctopus / beehiiv
# 空欄・未設定なら data/siteMetadata.js の newsletter.provider を使用（初期値: resend）
NEWSLETTER_PROVIDER=

# Resend: Contacts API 用のキーと、読者を登録する Segment の ID
RESEND_API_KEY=
RESEND_SEGMENT_ID=

# Buttondown
BUTTONDOWN_API_KEY=

# Mailchimp: API_SERVER は us1 などのデータセンター識別子
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

# Kit（旧 ConvertKit）: V3 API キーを使用
# Form ID: https://api.convertkit.com/v3/forms?api_key=<your_public_api_key>
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# Klaviyo
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# EmailOctopus: https://emailoctopus.com/api-documentation
# List ID は https://emailoctopus.com/lists でリストを選択した URL 内の UUID
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# Beehiiv: https://developers.beehiiv.com/docs/v2/bktd9a7mxo67n-create-an-api-key
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
